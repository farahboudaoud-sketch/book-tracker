[Unit]
Description=Book Tracker FastAPI app
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/book-tracker/backend
EnvironmentFile=/home/ubuntu/book-tracker/backend/.env
ExecStart=/home/ubuntu/book-tracker/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
